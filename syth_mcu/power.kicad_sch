	(text "260mA max from screen and audio,\n14*7mA max from hall effect on a board = 100mA per board,\nmcu chip takes 36mA max so 50mA,\n260mA + ((100+50)*5 boards) = 1.010A max for 5 boards,\nso psu and trace needs to be rated for 1.5A to run it 66% in worst case"
		(exclude_from_sim no)
		(at 125.222 32.004 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "ee704648-321f-4779-854c-538f8e9e0d71")
	)
