			)
			(justify left)
		)
		(uuid "3d8bc42e-3181-4666-9d51-fbf7bddfa14f")
	)
	(text "1.33mm 1oz for 1.5A at (30+10)deg,\nMax 3.2A peak fuse-protected short\nheats up to (30+60)deg,\n2.66mm for noise iso"
		(exclude_from_sim no)
		(at 147.066 37.592 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "a1a1f5ab-323a-4bb2-94bb-da5bf7a760ec")
	)
	(text "With ambient of 30deg,\n75% 125deg FR-4 -> 94 = 30+64deg\n75% 125deg AMS -> 94 = 30+64deg\n90deg/W for SOT-223 AMS1117 \nand (5-3.3)V across it, \nmax cont. current is 420mA at 94deg"
		(exclude_from_sim no)
		(at 27.432 62.23 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "c75b0616-fbea-4ff6-a272-71f74780a555")
	)
	(text "SS34 drops 0.4V at 1.0A, \n0.45 at 2.0A"
		(exclude_from_sim no)
		(at 146.812 26.416 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "e6a3ac95-5052-4eda-8cde-6db7cc870b9b")
	)
	(text "210mA max from screen and audio,\n14*7mA max from hall effect on a board = 100mA per board,\nmcu takes 50mA max,\nmux takes 50mA max,\n210mA + ((100+50+50)*5 boards) = 1.2A max for 5 boards,\nso psu and trace needs to be rated for 1.5A to run it 80% in worst case"
		(exclude_from_sim no)
		(at 147.066 32.258 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "ee704648-321f-4779-854c-538f8e9e0d71")
	)
	(text "0.90mm 1oz for 0.40A at (30+1)deg,\nMax 0.80A peak fuse-protected short\nheats up to (30+5)deg,\n1.80mm for noise iso"
